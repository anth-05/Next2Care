# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://<gebruiker>:<wachtwoord>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Database name inside the cluster
MONGODB_DB="next2care"

# Secret for login sessions (next step). Generate with: openssl rand -base64 32
AUTH_SECRET=""
